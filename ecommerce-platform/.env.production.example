# 生产环境配置
# 请将此文件内容复制到服务器上的 .env 文件并修改对应值

# ========== 数据库配置 ==========
# 宝塔面板 MySQL 连接信息
# 格式: mysql://用户名:密码@localhost:3306/数据库名
DATABASE_URL="mysql://ecommerce:your_password@localhost:3306/ecommerce_platform"

# ========== NextAuth 配置 ==========
# 生成随机密钥: openssl rand -base64 32
AUTH_SECRET="your-random-secret-key-here-change-this-in-production"
# 你的域名，例如: https://www.example.com
AUTH_URL="https://www.example.com"

# ========== Redis 配置（可选）==========
# 如果宝塔面板安装了 Redis，填写连接信息
REDIS_URL="redis://localhost:6379"

# ========== Cloudflare Turnstile 验证码 ==========
# 生产环境需要申请真实的密钥: https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-site-key"
TURNSTILE_SECRET_KEY="your-secret-key"

# ========== 阿里云 OSS 对象存储 ==========
# 用于图片上传，需要在阿里云控制台创建
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
OSS_BUCKET="your-bucket-name"
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"

# ========== Sentry 错误监控（可选）==========
NEXT_PUBLIC_SENTRY_DSN=""

# ========== 应用配置 ==========
NODE_ENV="production"
PORT=3000
