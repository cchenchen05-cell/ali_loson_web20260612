generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique @db.VarChar(100)
  email         String         @unique @db.VarChar(200)
  passwordHash  String         @db.VarChar(255)
  role          String         @default("editor") @db.VarChar(20) // superadmin, admin, editor
  isActive      Boolean        @default(true)
  firstLogin    Boolean        @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?        @db.VarChar(45)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]      @relation("ProductCreator")
  articles      Article[]      @relation("ArticleCreator")
  auditLogs     AuditLog[]
  loginRecords  LoginRecord[]
  reviews       Review[]       @relation("ReviewCreator")
  productLikes  ProductLike[]
}

model Category {
  id          Int         @id @default(autoincrement())
  parentId    Int?
  name        String      @db.VarChar(200)
  slug        String      @unique @db.VarChar(200)
  icon        String?     @db.VarChar(500)
  image       String?     @db.VarChar(500)
  previewImage String?    @db.VarChar(500)
  description String?     @db.Text
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryTree")
  products    Product[]
}

model Product {
  id              Int                 @id @default(autoincrement())
  categoryId      Int
  createdBy       Int?
  name            String              @db.VarChar(300)
  slug            String              @unique @db.VarChar(300)
  subtitle        String?             @db.VarChar(500)
  description     String?             @db.LongText
  summary         String?             @db.VarChar(500)
  coverImage      String?             @db.VarChar(500)
  images          String?             @db.Text // JSON array of {url, alt}
  price           Float?
  likeBase        Int                 @default(0)
  actualLikeCount Int                 @default(0)
  status          String              @default("draft") @db.VarChar(20) // draft, published, archived
  featured        Boolean             @default(false)
  sortOrder       Int                 @default(0)
  specifications  String?             @db.Text // JSON array of {key, value}
  seoTitle        String?             @db.VarChar(200)
  seoDescription  String?             @db.Text
  seoKeywords     String?             @db.VarChar(500)
  translations    String?             @db.Text // JSON {zh:..., en:...}
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  category        Category            @relation(fields: [categoryId], references: [id])
  creator         User?               @relation("ProductCreator", fields: [createdBy], references: [id])
  images_rel      ProductImage[]
  translations_rel ProductTranslation[]
  likes           ProductLike[]
  favorites       Favorite[]
  reviews         Review[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductTranslation {
  id             Int      @id @default(autoincrement())
  productId      Int
  locale         String   @db.VarChar(10)
  name           String?  @db.VarChar(300)
  description    String?  @db.LongText
  summary        String?  @db.VarChar(500)
  seoTitle       String?  @db.VarChar(200)
  seoDescription String?  @db.Text
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductLike {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int?
  visitorId String?  @db.VarChar(64)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  productId Int
  visitorId String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Article {
  id          Int      @id @default(autoincrement())
  createdBy   Int?
  title       String   @db.VarChar(300)
  slug        String   @unique @db.VarChar(300)
  content     String?  @db.LongText
  coverImage  String?  @db.VarChar(500)
  tags        String?  @db.VarChar(500)
  status      String   @default("draft") @db.VarChar(20) // draft, published
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User?    @relation("ArticleCreator", fields: [createdBy], references: [id])
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(200)
  imageUrl  String   @db.VarChar(500)
  linkUrl   String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaticContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  title     String?  @db.VarChar(200)
  content   String?  @db.LongText
  images    String?  @db.Text // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int?
  createdBy Int?
  clientName String? @db.VarChar(100)
  avatarUrl String?  @db.VarChar(500)
  videoUrl  String?  @db.VarChar(500)
  content   String?  @db.Text
  rating    Int      @default(5)
  tags      String?  @db.VarChar(500)
  status    String   @default("published") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  creator   User?    @relation("ReviewCreator", fields: [createdBy], references: [id], onDelete: SetNull)
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  inquiryNo    String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  phone        String   @db.VarChar(50)
  email        String   @db.VarChar(200)
  budget       String?  @db.VarChar(50)
  purchaseTime String?  @db.VarChar(50)
  address      String?  @db.VarChar(300)
  message      String?  @db.Text
  productIds   String?  @db.Text // JSON array of product IDs
  visitorId    String?  @db.VarChar(64)
  status       String   @default("pending") @db.VarChar(20) // pending, processing, completed, closed
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  eventType String   @db.VarChar(50) // page_view, product_click, inquiry_submit, search, favorite, share
  pagePath  String?  @db.VarChar(500)
  targetId  String?  @db.VarChar(100)
  visitorId String?  @db.VarChar(64)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  extraData String?  @db.Text // JSON
  createdAt DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   @db.VarChar(50) // create, update, delete, login, export, status_change
  targetType String?  @db.VarChar(50) // product, category, banner, article, announcement, review, inquiry, user
  targetId   String?  @db.VarChar(100)
  oldData    String?  @db.Text // JSON
  newData    String?  @db.Text // JSON
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model LoginRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Visitor {
  id          Int      @id @default(autoincrement())
  fingerprint String   @unique @db.VarChar(128)
  userAgent   String?  @db.Text
  ipAddress   String?  @db.VarChar(45)
  country     String?  @db.VarChar(100)
  region      String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  firstVisitAt DateTime @default(now())
  lastVisitAt  DateTime @default(now())
  visitCount   Int      @default(1)
  createdAt   DateTime @default(now())
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String?  @db.Text
  group     String?  @db.VarChar(50) // site, contact, social, email, upload, security
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Translation {
  id        Int      @id @default(autoincrement())
  key       String   @db.VarChar(200)
  locale    String   @db.VarChar(10)
  content   String   @db.Text // JSON
  namespace String   @default("frontend") @db.VarChar(50)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}